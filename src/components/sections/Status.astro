---
import Icon from '../Icon.astro';
import Markdown from '../Markdown.astro';
import SectionHeader from '../SectionHeader.astro';
import { linkAttrs } from '../../lib/links';
import type { SectionOf, Site } from '../../data/schema';

interface Props {
  section: SectionOf<'status'>;
  site: Site;
  /** Only set when the section has a heading; otherwise it reads as part of the section above. */
  index?: number;
  label: string;
}

const { section, site, index, label } = Astro.props;
const socialsById = new Map(site.socials.map((social) => [social.id, social]));
---

<section id={section.id} data-scene="status" class:list={[index ? 'section-pad' : 'pb-24 md:pb-32']}>
  <div class="container-site">
    {index && <SectionHeader index={index} label={label} heading={section.heading} />}

    <div class="grid gap-4 md:grid-cols-3">
      {
        section.cards.map((card) => {
          const socials = card.socialIds.flatMap((id) => socialsById.get(id) ?? []);
          return (
            <article
              class="card spotlight relative flex flex-col overflow-hidden p-6 md:p-7"
              style={`--accent: ${card.accent ?? 'var(--brand)'}; --accent-fg: color-mix(in oklab, var(--accent) 72%, var(--fg)); --spot: var(--accent)`}
              data-reveal
              data-tilt="6"
            >
              <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,var(--accent),transparent)]" />
              <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-[radial-gradient(60%_100%_at_50%_0%,color-mix(in_oklab,var(--accent)_14%,transparent),transparent)]" />

              <div class="relative flex items-center gap-3">
                <span class="grid size-10 place-items-center rounded-xl border border-line text-lg text-(--accent-fg)">
                  <Icon name={card.icon} />
                </span>
                <h3 class="font-semibold">{card.title}</h3>
              </div>

              <Markdown source={card.body} class="relative mt-5 text-[0.95rem] leading-relaxed text-muted" />

              {card.chips.length > 0 && (
                <ul class="relative mt-5 flex flex-wrap gap-2">
                  {card.chips.map((chip) => (
                    <li class="tag text-fg">{chip}</li>
                  ))}
                </ul>
              )}

              {socials.length > 0 && (
                <ul class="relative mt-auto flex gap-2 pt-6">
                  {socials.map((social) => (
                    <li>
                      <a href={social.href} {...linkAttrs(social.href)} class="social size-11 text-lg" data-magnetic aria-label={social.label} title={social.label}>
                        <Icon name={social.icon} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>
