---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import SiteImage from '../SiteImage.astro';
import SplitText from '../SplitText.astro';
import Tags from '../Tags.astro';
import type { SectionOf } from '../../data/schema';

interface Props {
  section: SectionOf<'projects'>;
  index: number;
  label: string;
}

const { section, index, label } = Astro.props;
const projects = section.projects.filter((p) => p.visible);
const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---

<section id={section.id} data-scene="projects" class="section-pad">
  <div class="container-site">
    <SectionHeader index={index} label={label} heading={section.heading} />

    <div class="space-y-28 md:space-y-40">
      {
        featured.map((project, i) => (
          <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
            <div class:list={['lg:col-span-7', i % 2 === 1 && 'lg:order-2']}>
              <div data-frame>
                <div class="project-frame" data-tilt="5">
                  <div class="overflow-hidden rounded-[1.25rem]">
                    {project.image ? (
                      <SiteImage
                        image={project.image}
                        widths={[480, 720, 960, 1280, 1600]}
                        sizes="(min-width: 1216px) 680px, (min-width: 1024px) 56vw, 100vw"
                        class="aspect-[16/10] w-full object-cover object-top"
                      />
                    ) : (
                      <div class="grid aspect-[16/10] place-items-center bg-[radial-gradient(circle_at_30%_20%,color-mix(in_oklab,var(--brand)_25%,transparent),transparent_60%)]">
                        <span class="heading-lg text-gradient px-6 text-center">{project.title}</span>
                      </div>
                    )}
                  </div>
                  <div class="tilt-glare rounded-[1.75rem]" />
                </div>
              </div>
            </div>

            <div class="relative lg:col-span-5">
              <span class="project-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <p class="eyebrow relative mb-4" data-reveal>Featured project</p>
              <h3 class="heading-lg relative" data-split>
                <span class="sr-only">{project.title}</span>
                <span aria-hidden="true"><SplitText text={project.title} /></span>
              </h3>
              <div class="relative" data-reveal>
                <p class="mt-5 text-lg leading-relaxed text-muted">{project.description}</p>
                <Tags tags={project.tags} class="mt-6" />
                <div class="mt-8 flex flex-wrap gap-3">
                  {project.links.map((link) => <Button link={link} />)}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {
      others.length > 0 && (
        <div class="mt-32 md:mt-44">
          {section.moreHeading && (
            <h3 class="heading-lg mb-10" data-split>
              <span class="sr-only">{section.moreHeading}</span>
              <span aria-hidden="true"><SplitText text={section.moreHeading} /></span>
            </h3>
          )}
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((project) => (
              <article class="card spotlight flex flex-col overflow-hidden" data-reveal data-tilt="6">
                {project.image && (
                  <SiteImage
                    image={project.image}
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
                    class="aspect-[16/10] w-full border-b border-line object-cover object-top"
                  />
                )}
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-start justify-between gap-4">
                    <h4 class="text-xl font-semibold tracking-tight">{project.title}</h4>
                    <Icon name="lucide:folder-git-2" class="mt-1 shrink-0 text-xl text-faint" />
                  </div>
                  <p class="mt-3 flex-1 leading-relaxed text-muted">{project.description}</p>
                  <Tags tags={project.tags} class="mt-5" />
                  <div class="mt-6 flex flex-wrap gap-2">
                    {project.links.map((link) => <Button link={link} size="sm" />)}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      )
    }

    {
      section.cta && (
        <div class="mt-16 text-center" data-reveal>
          <Button link={section.cta} />
        </div>
      )
    }
  </div>
</section>
